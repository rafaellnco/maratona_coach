# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Database
DATABASE_URL=sqlite:///./maratona_coach.db

# Telegram (canal principal)
TELEGRAM_BOT_TOKEN=
# Modo: auto | polling | webhook
# JustRunMy: TELEGRAM_MODE=polling (gerado pelo build-deploy-zip.ps1)
# Webhook (Fly/Oracle): TELEGRAM_MODE=webhook + PUBLIC_BASE_URL=https://...
TELEGRAM_MODE=auto
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Só tu podes usar o bot — obtém o ID em https://t.me/userinfobot
TELEGRAM_ALLOWED_USER_ID=
# Opcional: protege POST /notifications/trigger/* (cron externo grátis)
CRON_SECRET=
# BD persistente no host free:
# DATABASE_URL=sqlite:///./data/maratona_coach.db

# Scheduler (timezone do utilizador)
SCHEDULER_TIMEZONE=Europe/Lisbon
MORNING_BRIEFING_HOUR=9
MORNING_BRIEFING_MINUTE=0
LUNCH_SUPPLEMENTS_HOUR=14
LUNCH_SUPPLEMENTS_MINUTE=0
RUN_DAY_REMINDER_HOUR=17
RUN_DAY_REMINDER_MINUTE=0
DINNER_SUPPLEMENTS_HOUR=21
DINNER_SUPPLEMENTS_MINUTE=30
EVENING_RECOVERY_HOUR=22
EVENING_RECOVERY_MINUTE=30

# App
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
SHOWCASE_ENABLED=true

# Produção JustRunMy (polling) — gerado automaticamente pelo build-deploy-zip.ps1

# Produção Fly/Oracle (webhook) — exemplo:
# APP_ENV=production
# TELEGRAM_MODE=webhook
# PUBLIC_BASE_URL=https://teu-servico.fly.dev
# DATABASE_URL=sqlite:////data/maratona_coach.db
# PORT=8000
# SHOWCASE_ENABLED=false
